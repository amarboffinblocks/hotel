# =============================================================================
# Grandview Hotel — ALL environment variables
# Copy: cp .env.example .env.local
# Server also loads this file (then server/.env overrides if present)
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js (web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Express API (server)
# -----------------------------------------------------------------------------
# Use 4000 — macOS AirPlay often occupies port 5000
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/grandview

# -----------------------------------------------------------------------------
# Auth (JWT + admin login) — keep ADMIN_* in sync for Next proxy + API
# -----------------------------------------------------------------------------
JWT_SECRET=grandview-dev-secret-change-in-production
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=grandview

# -----------------------------------------------------------------------------
# Cloudinary (image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=grandview
